+/* The numeric parent pid is 0 in a fresh PID namespace. An inherited
+ * pidfd identifies the original outside monitor even if it has already died
+ * and this child was reparented. Arm before polling to cover both orderings.
+ */
+static void
+monitor_parent_guard (int monitor_pidfd)
+{
+  struct pollfd descriptor;
+  int result;
+
+  if (monitor_pidfd == -1)
+    return;
+
+  handle_die_with_parent ();
+  descriptor.fd = monitor_pidfd;
+  descriptor.events = POLLIN;
+  descriptor.revents = 0;
+  result = TEMP_FAILURE_RETRY (poll (&descriptor, 1, 0));
+  if (result < 0)
+    die_with_error ("poll monitor pidfd");
+  if (result != 0)
+    die ("Isolation monitor exited before namespace startup completed");
+}
