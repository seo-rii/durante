+}
+
+unsigned int
+dr_durante_runtime_abi_version(void)
+{
+#if defined(LINUX) && defined(X86) && defined(X64)
+    return DR_DURANTE_RUNTIME_ABI_VERSION;
+#else
+    return 0;
+#endif
+}
+
+void
+dr_register_durante_code_replay_event(dr_durante_code_replay_cb_t callback)
+{
+    add_callback(&durante_code_replay_callbacks, (void (*)(void))callback, true);
+}
+
+bool
+dr_unregister_durante_code_replay_event(dr_durante_code_replay_cb_t callback)
+{
+    return remove_callback(&durante_code_replay_callbacks, (void (*)(void))callback, true);
+}
+
+void
+instrument_durante_code_replay(dcontext_t *dcontext, int reason, app_pc source_pc,
+                                app_pc target_pc)
+{
+    /* Do not set client_data->cur_mc/os_cxt: unlike a kernel transfer, this
+     * private event is informational and cannot change application execution.
+     * Use the standard callback snapshot, whose lock is released before invoking
+     * clients, including when the notification originates in a signal handler.
+     */
+    if (durante_code_replay_callbacks.num == 0)
+        return;
+    /* Empty result/assignment operands preserve the exact void callback type. */
+    call_all_ret(, , , durante_code_replay_callbacks, dr_durante_code_replay_cb_t,
+                 (void *)dcontext, reason, source_pc, target_pc);
 }

