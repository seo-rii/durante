+/* Set once this core instance runs inside the reserved -durante_window. */
+bool durante_window_ready;
+
+bool
+durante_window_overlaps(const byte *start, size_t size)
+{
+    ptr_uint_t base = DYNAMO_OPTION(durante_window);
+    if (base == 0 || size == 0)
+        return false;
+    ptr_uint_t first = (ptr_uint_t)start;
+    ptr_uint_t last = first + size - 1;
+    if (last < first)
+        last = POINTER_MAX; /* A wrapping range reaches the top of the address space. */
+    return first < base + DURANTE_WINDOW_SIZE && last >= base;
+}
+
+bool
+durante_window_reserve_all(void)
+{
+    byte *window = (byte *)DYNAMO_OPTION(durante_window);
+    byte *map = mmap_syscall(window, DURANTE_WINDOW_SIZE, PROT_NONE,
+                             MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE |
+                                 MAP_FIXED_NOREPLACE,
+                             -1, 0);
+    if (map == window)
+        return true;
+    if (mmap_syscall_succeeded(map))
+        munmap_syscall(map, DURANTE_WINDOW_SIZE);
+    return false;
+}
+
+byte *
+durante_window_reserve_slot(ptr_uint_t offset, size_t size)
+{
+    ptr_uint_t base = DYNAMO_OPTION(durante_window);
+    if (base == 0 || !durante_window_ready || offset < DURANTE_WINDOW_GUARD ||
+        size > DURANTE_WINDOW_SIZE - DURANTE_WINDOW_GUARD - offset)
+        return NULL;
+    byte *slot = (byte *)(base + offset);
+    byte *map = mmap_syscall(slot, size, PROT_NONE,
+                             MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED, -1, 0);
+    return map == slot ? slot : NULL;
+}
